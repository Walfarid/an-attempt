# Keep build context lean and reproducible.
.git
.github
.ai
.vscode
.idea
.editorconfig
.pre-commit-config.yaml
.gitattributes
.gitignore

# Local runtime artifacts
.env
.env.*
!.env.example
node_modules
vendor
public/build
public/hot
public/storage
storage/logs
storage/app
storage/inertia-devtools
storage/framework/cache/data
storage/framework/cache/*.php
storage/framework/sessions
storage/framework/testing
storage/framework/views
bootstrap/cache/*.php
.phpunit.cache
.codegraph
.claude
.playwright-mcp

# Local dev database — MariaDB is the real store in every environment
database/*.sqlite*

# Tests and benchmarks never run in the image (composer installs --no-dev)
tests
benchmarks

# Screenshots / scratch
*.png
*.jpg
*.jpeg
*.webp

# Local binaries
frankenphp
frankenphp-worker.php
**/caddy

# Docs and workflows are not needed in the image
*.md
docker/
!docker/zz-opcache.ini
!docker/zz-upload.ini
compose.yaml
compose.prod.yaml
