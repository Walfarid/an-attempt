APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id
# BCRYPT_ROUNDS=12
# HASH_VERIFY=false  # set to false when migrating from another algorithm

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Sessions/cache/queue use Valkey (compose.yaml) — do not downgrade to
# database: that reintroduces 2-3 extra queries per request (see round 11).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PERSISTENT=true

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_REDIRECT_URL="${APP_URL}/authenticate"

# ── Garage (local S3-compatible object storage, Docker) ──────────────────────
# Consumed by compose.yaml to auto-provision the bucket + access key.
# Dev placeholders — rotate for anything beyond local development.
# Swapping to Oracle Cloud buckets later = replacing the AWS_* block only.
GARAGE_BUCKET=walfa
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903
GARAGE_ACCESS_KEY_ID=GK6f3a9c1e8d2b4a7f0c5e9d1b3a6f8c20
GARAGE_SECRET_ACCESS_KEY=1d4c7b0a93e85f2164ab30dc95e71f082b5ad6c39e04f17ba82c5d60931ef74b

AWS_ACCESS_KEY_ID="${GARAGE_ACCESS_KEY_ID}"
AWS_SECRET_ACCESS_KEY="${GARAGE_SECRET_ACCESS_KEY}"
AWS_DEFAULT_REGION=garage
AWS_BUCKET="${GARAGE_BUCKET}"
AWS_URL=http://127.0.0.1:${GARAGE_S3_PORT}/${GARAGE_BUCKET}
AWS_ENDPOINT=http://127.0.0.1:${GARAGE_S3_PORT}
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Contact form ─────────────────────────────────────────────────────────────
CONTACT_NOTIFICATION_EMAIL="hello@example.com"
# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"

# ── Analytics ──────────────────────────────────────────────────────────────────
# Microsoft Clarity — https://clarity.microsoft.com/ → New Project → copy Project ID
CLARITY_PROJECT_ID=

# Google Analytics 4 — https://analytics.google.com/ → Admin → Data Streams → Measurement ID (G-XXXXXXX)
GOOGLE_ANALYTICS_ID=
